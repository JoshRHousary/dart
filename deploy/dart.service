[Unit]
Description=DART direct-mail campaign tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=PYTHONUNBUFFERED=1
# Caddy terminates TLS in front, so the session cookie must carry Secure.
Environment=DART_SECURE_COOKIES=1
ExecStart=__APP_DIR__/venv/bin/python __APP_DIR__/serve.py 8787
Restart=always
RestartSec=3

# The app only ever needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__APP_DIR__/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
